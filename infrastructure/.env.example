# Lugx Gaming Platform - Database Infrastructure Environment Variables
# Copy this file to .env and update with your secure passwords

# PostgreSQL - Game Service
POSTGRES_GAME_DB=lugx_games
POSTGRES_GAME_USER=game_service
POSTGRES_GAME_PASSWORD=game_secure_password_2024
POSTGRES_GAME_PORT=5432

# PostgreSQL - Order Service
POSTGRES_ORDER_DB=lugx_orders
POSTGRES_ORDER_USER=order_service
POSTGRES_ORDER_PASSWORD=order_secure_password_2024
POSTGRES_ORDER_PORT=5433

# ClickHouse - Analytics Service
CLICKHOUSE_DB=lugx_analytics
CLICKHOUSE_USER=analytics_service
CLICKHOUSE_PASSWORD=analytics_secure_password_2024
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis - Caching & Sessions
REDIS_PASSWORD=redis_secure_password_2024
REDIS_PORT=6379

# pgAdmin (Development Only)
PGADMIN_EMAIL=admin@lugxgaming.com
PGADMIN_PASSWORD=admin_password_2024
PGADMIN_PORT=5050

# Network Configuration
DOCKER_NETWORK_SUBNET=172.28.0.0/16